# ==============================================================================
# FoodRescue Environment Variables Template
# Copy this file to .env in your backend / frontend directories or root
# NEVER commit real .env files with actual secrets to version control!
# ==============================================================================

# Backend Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodrescue_db

# Authentication (JWT - JSON Web Token)
# In production, generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=foodrescue_dev_secret_key_change_in_production_123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Future: External Mapping / Geocoding API
MAP_API_KEY=your_map_service_api_key_here
